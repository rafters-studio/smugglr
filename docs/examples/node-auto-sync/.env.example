# Local side: a SQLite file whose tables also exist at the destination.
LOCAL_DB=./app.sqlite

# Time between syncs, in milliseconds. 30000 is the default.
SYNC_INTERVAL_MS=30000

# Destination: the local HTTP-SQL endpoint from ../node-server-to-d1/local-endpoint.mjs.
DEST_URL=http://127.0.0.1:8765
DEST_PROFILE=generic
DEST_TOKEN=

# Destination, production variant: Cloudflare D1. Needs an API token with
# D1:Edit scope from https://dash.cloudflare.com/profile/api-tokens.
# DEST_URL=https://api.cloudflare.com/client/v4/accounts/<account-id>/d1/database/<database-id>/query
# DEST_PROFILE=d1
# DEST_TOKEN=<cloudflare-api-token>

{
  "name": "@smugglr/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The smugglr engine in a browser tab.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.js",
    "./engine": {
      "workerd": "./src/workerd.js",
      "default": "./src/engine/smugglr_web.js"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/smugglr-web --target web --dev --no-pack",
    "prepack": "node scripts/prepack.mjs"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "playwright": "1.64.0"
  }
}
